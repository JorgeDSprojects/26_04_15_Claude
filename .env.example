# =============================================================
# AeroNorth UNS — Environment variables
# Copy this file to .env and adjust as needed.
# =============================================================

# ---------- MQTT broker (EMQX) ----------
# Hostname used by services running inside the uns-network.
# From the host, use localhost:1884 (port 1883 may be occupied by a local broker).
MQTT_HOST=mqtt-broker
MQTT_PORT=1883

# ---------- Host-side MQTT access ----------
# Use these values in .env when running scripts from the host machine.
# MQTT_HOST=localhost
# MQTT_PORT=1884

# EMQX dashboard credentials (http://localhost:18083)
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=public

# ---------- MQTT auth (clients) ----------
MQTT_USER=testuser
MQTT_PASSWORD=testpass

# ---------- TimescaleDB ----------
TIMESCALE_HOST=timescaledb
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=tspass
TIMESCALE_DB=metrics

# ---------- Simulator ----------
SIM_INTERVAL_MS=10000
SIM_ASSET_PATH=aeronorth/windfarm_north/sector_a/turbine_03
